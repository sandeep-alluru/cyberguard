# --- build artefacts -------------------------------------------------------
__pycache__/
*.pyc

# --- NEVER commit model weights or checkpoints -----------------------------
# These are the release artefact, not the evaluation record. If a tool drops one
# here, it stays out of the repository.
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.onnx
*.h5
*.msgpack
adapters/
models/

# --- NEVER commit row-level data -------------------------------------------
# Training corpora, held-out sets, mixtures and probe sets are out of bounds.
# The two exceptions below are published public-benchmark files that are
# already tracked; the negations keep a fresh clone consistent.
*.jsonl
*.parquet
*.arrow
*.npz
!results/pubbench/harmbench/harmbench_behaviors_text_test.csv
!results/pubbench/secqa_test.csv

# --- never commit credentials or environment ------------------------------
.env
.env.*
*.pem
*.key
credentials.json
cyberguard-env

# --- local scratch ---------------------------------------------------------
scratch/
tmp/
.venv/
venv/
